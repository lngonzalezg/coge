<script>
jQuery(document).ready(function(){
    pageObj = new Object();

    // Display alert if Internet Explorer
    //if (jQuery.browser.msie) {browserAlert()}; // mdb removed 10/20/16

    setup_button_states();

    // Show indicator if not on main site
    if (   document.URL.indexOf('genomevolution.org') == -1 
    	&& document.URL.indexOf('genomeevolution.org') == -1
    	&& document.URL.indexOf('coge.iplantcollaborative.org') == -1)
    {
        // Show the build stamp (datetime + COGE_REF) over the logo instead of a
        // static "Development" label; fall back to "Development" if unset.
        var cogeBuild = (window.COGE_BUILD && window.COGE_BUILD.length) ? window.COGE_BUILD : 'Development';
        $('#brand').attr('data-build', ' ' + cogeBuild).addClass("dev");
    }
    
    $('.dropdown-menu').mouseleave(function(e){
		hideDropdowns();
   	});
    
	$('.dropdown-label').mouseenter(function(e){
		var target = $(e.target).closest('.dropdown-label');
		var id = target.attr('id');
		if (id)
			showDropdown('#' + id.slice(0,4) + '_drop');
	});

	// Advanced search: toggle on the trigger, close on click-outside or Esc —
	// never on mouseleave, which threw away everything the user had typed.
	$('#advanced_search_label').click(function(e){
		e.stopPropagation();
		var panel = $('#coge-advanced-search');
		if (panel.is(':visible'))
			panel.hide();
		else {
			hideDropdowns();
			panel.slideDown('fast');
		}
	});
	$(document).on('click', function(e){
		if (!$(e.target).closest('#advanced_search').length)
			$('#coge-advanced-search').hide();
	});
	$(document).on('keydown', function(e){
		if (e.which == 27)
			$('#coge-advanced-search').hide();
	});

	// Chips and segment drive the hidden selects search() reads.
	$('#adv_type_chips .coge-adv-chip').click(function(){
		$('#advanced_search_type').val($(this).attr('data-value'));
		adv_render();
	});
	$('.coge-adv-toggle').click(function(){
		var sel = $('#' + $(this).attr('data-select'));
		if (!sel.length) return;
		sel.val(sel.val() == $(this).attr('data-on') ? $(this).attr('data-off') : $(this).attr('data-on'));
		adv_render();
	});
	$('#adv_role_segment span').click(function(){
		$('#search_role').val($(this).attr('data-value'));
		adv_render();
	});
	$('#search_tag, #search_feature_type, #search_metadata_key, #search_metadata_value, #header_search_text').on('input', adv_render);
	adv_render();

    $('.dropdown-label').mouseleave(function(e){
       	if (e.relatedTarget && !e.relatedTarget.closest('.dropdown-menu'))
       	    hideDropdowns();
    });

    // Add logout detector -- mdb added 9/1/16 COGE-724
    if (coge.logout) { // coge.logout module will not be present if in embedded mode
        coge.logout.init({
            loginCookieName: '<TMPL_VAR NAME="COOKIE_NAME">', // should be set by page to enable logout detection
            loginCallback: login_oidc // default flow; falls back to CAS server-side if OIDC unconfigured
        });
    }

	updateAdvancedSearch();
});

function browserAlert(){
    $('#main_alert').html('IE is not supported.  Please use FireFox: http://www.mozilla.com/en-US/firefox/');
    alert('IE is not supported.  Please use FireFox: http://www.mozilla.com/en-US/firefox/');
}

//set up the jquery ui button behavior
function setup_button_states (id) {
    //button effects on events
	var item;

	if (id) { item='#'+id; }
	else { item = '.ui-button'; }
	$(item+':not(.ui-state-disabled)')
		.hover( function(){
			$(this).addClass("ui-state-hover");
		},
		function(){
			$(this).removeClass("ui-state-hover");
		});
	$(item+':not(.ui-button-toggle)') //buttons that aren't toggle-able
		.mousedown(function(){
			$(this).addClass("ui-state-active");
		})
		.mouseup(function(){
			$(this).removeClass("ui-state-active");
		});
	$(item+'.ui-button-toggle') // buttons that are toggle-able
		.click(function(){
			if( $(this).hasClass('ui-state-active') ){
				$(this).removeClass("ui-state-active");
			}
			else { $(this).addClass("ui-state-active"); }
		});

}

//add button behavior to new buttons, takes in array
function add_button_states (ids) {
    if (!ids)
		return;
    if (!(ids instanceof Array))
		ids = [ids]; //check if ids is an array, if not, make it one
    for (var i=0; i<ids.length; i++)
        setup_button_states(ids[i]);
}

// Pull key::value terms out of free text — they belong to the panel fields.
function strip_adv_terms(text) {
	if (!text) return '';
	var index = text.indexOf('::');
	while (index != -1) {
		var start = index;
		while (start > 0 && text.charAt(start) != ' ' && text.charAt(start) != '"')
			--start;
		var c = start > 0 ? text.charAt(start) : ' ';
		while (start > 1 && text.charAt(start - 1) == ' ')
			--start;
		var end = index + 2;
		while (end < text.length && text.charAt(end) != c)
			++end;
		while (end < text.length && text.charAt(end) == ' ')
			++end;
		text = start > 0 && end < text.length ? text.substring(0, start) + ' ' + text.substring(end) : start > 0 ? text.substring(0, start) : text.substring(end);
		index = text.indexOf('::');
	}
	return text.trim();
}

// Same terms, same order, as the old inline search() logic — the panel and
// the live preview both build from here, so what you see is what runs.
function build_adv_terms() {
	var terms = [];
	var type = $('#advanced_search_type').val();
	if (type != 'any')
		terms.push('type::' + type);
	var certified = $('#search_certified').val();
	if (certified != 'any')
		terms.push('certified::' + (certified == 'yes' ? '1' : '0'));
<TMPL_IF NAME="LOGON">
	var deleted = $('#search_deleted').val();
	if (deleted == 'yes')
		terms.push('deleted::1');
	var favorite = $('#search_favorite').val();
	if (favorite != 'any')
		terms.push('favorite::1');
</TMPL_IF>
	var feature_type = $('#search_feature_type').val();
	if (feature_type)
		terms.push('feature_type::' + feature_type);
	var metadata_key = $('#search_metadata_key').val();
	if (metadata_key)
		terms.push('metadata_key::' + metadata_key);
	var metadata_value = $('#search_metadata_value').val();
	if (metadata_value)
		if (metadata_value.indexOf(' ') != -1)
			terms.push('"metadata_value::' + metadata_value + '"');
		else
			terms.push('metadata_value::' + metadata_value);
<TMPL_IF NAME="LOGON">
	var restricted = $('#search_restricted').val();
	if (restricted != 'any')
		terms.push('restricted::' + (restricted == 'yes' ? '1' : '0'));
	var role = $('#search_role').val();
	if (role != 'any')
		terms.push('role::' + role);
</TMPL_IF>
	var tag = $('#search_tag').val();
	if (tag)
		if (tag.indexOf(' ') != -1)
			terms.push('"tag::' + tag + '"');
		else
			terms.push('tag::' + tag);
	return terms;
}

function search() {
	// Filters apply whether or not the panel is open — the count badge on the
	// trigger is the indicator that they are set.
	var text = strip_adv_terms($('#header_search_text').val());
	var terms = build_adv_terms();
	if (text)
		terms.unshift(text);
	if (terms.length)
		window.location.href = 'SearchResults.pl?s=' + terms.join(' ');
	else
		alert('Search not specified');
}

// Paint chips/segment from the selects, refresh badge and query preview.
function adv_render() {
	var typeVal = $('#advanced_search_type').val();
	$('#adv_type_chips .coge-adv-chip').each(function(){
		$(this).toggleClass('on', $(this).attr('data-value') == typeVal);
	});
	$('.coge-adv-toggle').each(function(){
		var sel = $('#' + $(this).attr('data-select'));
		$(this).toggleClass('on', sel.length > 0 && sel.val() == $(this).attr('data-on'));
	});
	var roleVal = $('#search_role').length ? $('#search_role').val() : null;
	$('#adv_role_segment span').each(function(){
		$(this).toggleClass('on', $(this).attr('data-value') == roleVal);
	});
	var terms = build_adv_terms();
	$('#adv_filter_count').text(terms.length).toggleClass('hidden', terms.length == 0);
	var text = strip_adv_terms($('#header_search_text').val() || '');
	var all = text ? [text].concat(terms) : terms;
	$('#adv_query_preview').text('s=' + all.join(' '));
}

function clear_advanced_search() {
	$('#advanced_search_type').val('any');
	$('#search_certified').val('any');
	$('#search_deleted').val('no');
	$('#search_favorite').val('any');
	$('#search_restricted').val('any');
	$('#search_role').val('any');
	$('#search_tag, #search_feature_type, #search_metadata_key, #search_metadata_value').val('');
	adv_render();
}

function updateAdvancedSearch() {
	if (typeof QUERY == 'undefined')
		return;
	['certified', 'deleted', 'favorite', 'restricted', 'role'].forEach(function(opt) {
		if (QUERY[opt])
			$('#search_' + opt).val(QUERY[opt] == 1 ? 'yes' : 'no');
	});
	['feature_type', 'metadata_key', 'metadata_value', 'tag', 'type'].forEach(function(opt) {
		if (QUERY[opt])
			$('#search_' + opt).val(QUERY[opt]);
	});
	adv_render();
}

function searchKey(event) {
	if (event.which == 13) {
		event.preventDefault(); //Without this, the page just reloads
		search();
	}
}

function showDropdown(id) {
	hideDropdowns();
	$(id).slideDown('fast');
	var e = $(id + '_label').find('.dropdown-arrow');
	if (e.attr('src') == 'picts/arrow-right-icon.png')
    	e.attr('src', 'picts/arrow-down-icon.png');
}

function hideDropdown(id) {
	var e = $(id + '_label').find('.dropdown-arrow');
	if (e.attr('src') == 'picts/arrow-down-icon.png')
    	e.attr('src', 'picts/arrow-right-icon.png');
}

function hideDropdowns() {
	$('.dropdown-menu').hide();
	hideDropdown('#help_drop');
	hideDropdown('#tool_drop');
	hideDropdown('#user_drop');
	hideDropdown('#auth_drop');
	hideDropdown('#advanced_search');
	$('#coge-advanced-search').hide();
}

</script>

