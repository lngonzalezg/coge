<!-- JBrowse2 viewer shell (Phase B). Bundles are VENDORED under
     web/js/jbrowse2/ -- the CSP is script-src 'self', deliberately, so no CDN.
     LGV pinned to the mature 2.x line: 3.1.0 threw "invalid range in character
     class" from its config-expression system the first time feature rendering
     actually ran (2026-08-18). React 18 UMD satisfies both lines (2.x wants
     >=16.8); React 19 dropped UMD builds, so 18.x is the ceiling for this
     script-tag embedding style. Web workers come from blob: URLs, covered by
     the worker-src 'self' blob: CSP directive (added 2026-08-17). -->

<style>
  /* Full-viewport genome browser (2026-08-18). NO_BOX in GenomeView2.pl already
     removes the page gutter; this stretches the view to the bottom of the
     window. The LGV paints its natural height (sum of tracks) inside; the
     min-height keeps the page from looking like a cramped strip. 120px
     approximates the CoGe header; embeds (?embed=1) have no header, and the
     rule errs generous rather than clipping. */
  #jbrowse2_view {
    width: 100%;
    min-height: calc(100vh - 120px);
    /* CoGe design system: green-8 primary border so the browser box matches
       the rest of the page (vars from coge-modern.css). */
    border: 1px solid var(--coge-green-8, #2f9e44);
    border-radius: var(--coge-radius, 4px);
  }
</style>
<div id="jbrowse2_error" style="display:none;padding:1em;color:#a00;"></div>
<div id="jbrowse2_view"></div>

<script src="js/jbrowse2/react-18.3.1.min.js"></script>
<script src="js/jbrowse2/react-dom-18.3.1.min.js"></script>
<script src="js/jbrowse2/react-linear-genome-view-2.18.0.umd.min.js"></script>
<script src="js/pages/genome-view2.js"></script>
