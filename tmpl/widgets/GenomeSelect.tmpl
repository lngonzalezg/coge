<SCRIPT LANGUAGE="JavaScript">

// Inline Tabler icon SVGs (the site CSP blocks icon CDNs).
var GPK_SVG = {
	search: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/><path d="M21 21l-6 -6"/></svg>',
	plus: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5l0 14"/><path d="M5 12l14 0"/></svg>',
	x: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>',
	chev: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6l-6 6"/></svg>',
	info: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/><path d="M12 9h.01"/><path d="M11 12h1v4h1"/></svg>',
	trash: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l16 0"/><path d="M10 11l0 6"/><path d="M14 11l0 6"/><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"/><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"/></svg>',
	download: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"/><path d="M7 11l5 5l5 -5"/><path d="M12 4l0 12"/></svg>',
	save: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h10l4 4v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2"/><path d="M12 14m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M14 4l0 4l-6 0l0 -4"/></svg>'
};

$(document).ready(function(){

	$("#org_name_desc").keyup(
		function() {
			org_search();
		}
	);

	$('#add_all_listed_button').click(
		function() {
			if ($('#org_id option:not(:disabled)').length) {
				add_all_orgs();
			}
		}
	);

	$("#genome_info_button").click(
		function() {
			$('#genome_info_popup').html('<span class="small">Loading...</span><img src="picts/ajax-loader.gif">').dialog('open');
			if ($('#dsgid').val()) {
				var dsgid = $('#dsgid').val();
				$.ajax({
					data: {
						jquery_ajax: 1,
						fname: 'get_genome_info',
						dsgid: dsgid[0],
					},
					success : function(html) {
						$('#genome_info_popup').html(html);
					}
				});
			}
		}
	);

	// Initial render from any server-provided organism list
	render_orgs();
	render_basket();
});

function org_search(desc_search){
	if (pageObj.time) {
		clearTimeout(pageObj.time);
	}

	name_desc = $('#org_name_desc').val();
	if (name_desc.length < 3) { return; } //>

	pageObj.time = setTimeout(
		function() {
			$("#wait_indicator").css({opacity:1});
			$.ajax({
				data: {
					jquery_ajax: 1,
					fname: 'get_orgs',
					name_desc: name_desc,
					timestamp: new Date().getTime()
				},
				success : function(data) {
					var items = jQuery.parseJSON(data);
					if (!pageObj.timestamp_get_orgs || items.timestamp > pageObj.timestamp_get_orgs) {
						pageObj.timestamp_get_orgs = items.timestamp;
						$("#wait_indicator").animate({opacity:0});
						$('#org_id').html(items.html);
						seq_type_search();
						update_buttons();
						count_organisms();
						render_orgs();
					}
				}
			});
		},
		500
	);
}

function update_buttons(remove) {
	if ($('#org_id').val() && $('#dsgid').val()) {
		$('#genome_info_button').removeClass('ui-state-disabled');
	}
	else {
		$('#genome_info_button').addClass('ui-state-disabled');
	}
}

function get_dsg_for_menu(opts) {
	$.ajax({
		data: {
			jquery_ajax: 1,
			fname: 'get_dsg_for_menu',
			dsgid: opts.dsgid,
			orgid: opts.orgid,
		},
		success : function(data) {
			add_to_list(data);
			sort_genome_choice();
		}
	});
}

function seq_type_search() {
	var oid = $('#org_id').val();

	if (oid && oid.length) {
		$.ajax({
			data: {
				jquery_ajax: 1,
				fname: 'gen_dsg_menu',
				oid: oid[0] //join(',', oid)
			},
			success : function(html) {
				$('#dsgid').html(html);
				var count = $('#dsgid option').length;
				$('#genome_count').html(count);
				update_buttons();
				render_genomes();
			}
		});
	}
	else {
		$('#dsgid').html('');
		update_buttons();
		render_genomes();
	}
}

function remove_selected_orgs() {
	$('#genome_choice option:selected').each(function(){
		$('#'+$(this).val()).remove();
	});
	count_genomes();
}

function add_all_orgs() {
	var ids;
	$('#org_id option').each(function(){
		ids = ids+","+$(this).val();
	});
	get_dsg_for_menu({orgid: ids});
}

function add_selected_orgs() {
	var ids;
	var count = 0;
	$('#org_id option:selected').each(function() {
		ids = ids + "," + $(this).val();
		count++;
	});

	if (count == 1) {
		var dsgid = $('#dsgid').val();
		get_dsg_for_menu({dsgid: dsgid[0]});
	}
	else {
		get_dsg_for_menu({orgid: ids});
	}
}

function add_to_list(stuff) {
	var orgs = stuff.split(':::');
	for (var i=0; i < orgs.length; i++) { //>
		var item = orgs[i].split('::');
		id = item[0];
		org = item[1];
		if (!id && !org) { continue; }
		var check = $('#'+id).val();
		if (check){ continue; }
		var html = '<option id='+id+' value='+id+'>'+org+'</option>';
		$('#blank').remove();
		$('#genome_choice').append(html);
	}
	count_genomes();
}

function sort_genome_choice() {
	$('#genome_choice').append().sortSelect();
	render_basket();
}

function count_organisms() {
	var count = $('#org_id option:not(:disabled)').length;
	if (count) {
		$('#add_all_listed_button').removeClass('ui-state-disabled');
	}
	else {
		$('#add_all_listed_button').addClass('ui-state-disabled');
	}
	$('#org_count').html(count);
	// Render here, not only in org_search: pages (blast.js) ship their own
	// org_search, and a stale-cached copy would otherwise skip the row list.
	render_orgs();
}

function count_genomes() {
	var count = $('#genome_choice').getLength();

	if (count) {
		$('#clear').removeClass('ui-state-disabled');
	}
	else {
		$('#clear').addClass('ui-state-disabled');
		$('#genome_choice').html('<option id="blank" value=null style="color:gray;" disabled="disabled">None</option>');
	}

	$('#selected_genome_count').html(count);
	$('.coge-genome-select-ctx').text(count == 1 ? '1 genome selected' : count + ' genomes selected');
	render_basket();
	render_genomes();
}

function clear_org_list() {
	$('#genome_choice').empty();
	count_genomes();
}

/* ---- Render layer: mirrors the hidden selects as modern row lists ---- */

function render_orgs() {
	var list = $('#gpk_org_rows');
	if (!list.length) return;
	list.empty();
	var opts = $('#org_id option');
	if (!opts.length) {
		list.append($('<div class="coge-picker-empty"></div>').text('Search for organisms above (3 letters or more).'));
		return;
	}
	opts.each(function() {
		var opt = this;
		var row = $('<div class="coge-picker-row org"></div>').toggleClass('selected', opt.selected);
		$('<span class="row-label"></span>').text(opt.text).appendTo(row);
		$('<span class="row-chev">' + GPK_SVG.chev + '</span>').appendTo(row);
		row.on('click', function() {
			$('#org_id option').prop('selected', false);
			opt.selected = true;
			seq_type_search();
			update_buttons();
			render_orgs();
		});
		list.append(row);
	});
}

function render_genomes() {
	var list = $('#gpk_genome_rows');
	if (!list.length) return;
	list.empty();
	var opts = $('#dsgid option');
	if (!opts.length) {
		list.append($('<div class="coge-picker-empty"></div>').text('Pick an organism to list its genomes.'));
		return;
	}
	opts.each(function() {
		var opt = this;
		var added = $('#genome_choice option').filter(function() { return this.id == opt.value; }).length > 0;
		var row = $('<div class="coge-picker-row"></div>')
			.toggleClass('selected', opt.selected && !added)
			.toggleClass('added', added);
		$('<span class="row-label"></span>').html(opt.text).appendTo(row);
		var btn = $('<span class="coge-picker-addbtn" title="Add to selection">' + GPK_SVG.plus + '</span>').appendTo(row);
		btn.on('click', function(e) {
			e.stopPropagation();
			if (!added) get_dsg_for_menu({dsgid: opt.value});
		});
		row.on('click', function() {
			$('#dsgid option').prop('selected', false);
			opt.selected = true;
			update_buttons();
			render_genomes();
		});
		list.append(row);
	});
}

function render_basket() {
	var list = $('#gpk_basket');
	if (!list.length) return;
	list.empty();
	var opts = $('#genome_choice option').not('#blank');
	if (!opts.length) {
		list.append($('<div class="coge-picker-empty"></div>').text('None'));
		return;
	}
	// Group by organism: basket text is "<organism> (id <n> <source> <type> v<x>)"
	var groups = [], byName = {};
	opts.each(function() {
		var opt = this;
		var text = $(opt).text();
		var idx = text.indexOf(' (id ');
		var org = idx > 0 ? text.substring(0, idx) : '';
		var rest = idx > 0 ? text.substring(idx + 2).replace(/\)\s*$/, '') : text;  // "id ..." detail
		if (!byName[org]) {
			byName[org] = { name: org, items: [] };
			groups.push(byName[org]);
		}
		byName[org].items.push({ id: opt.id, detail: rest });
	});
	groups.forEach(function(g) {
		var group = $('<div class="coge-picker-group"></div>');
		if (g.name)
			$('<div class="coge-picker-grouphead"></div>').text(g.name).appendTo(group);
		g.items.forEach(function(item) {
			var row = $('<div class="coge-picker-basketrow"></div>');
			$('<span class="row-label"></span>').text(g.name ? item.detail : item.detail).attr('title', (g.name ? g.name + ' ' : '') + item.detail).appendTo(row);
			$('<span class="coge-picker-removebtn" title="Remove">' + GPK_SVG.x + '</span>')
				.on('click', function() {
					$('#genome_choice option').filter(function() { return this.id == item.id; }).remove();
					count_genomes();
				})
				.appendTo(row);
			group.append(row);
		});
		list.append(group);
	});
}

function save_org_list() {
	//save_settings(['args__dsgids','args__'+$('#genome_choice').getLength(1), 'args__resultslimit','resultslimit'],[]);
	$.ajax({
		data: {
			jquery_ajax: 1,
			fname: 'save_settings',
			dsgids: $('#genome_choice').getLength(1),
			resultslimit: $('#resultslimit').val(),
		},
		success : function() {
			alert('Selected genomes haved been saved and will be loaded by default.');
		},
	});
}

function search_lists (search_term) {
	if ($('#import_list_box').dialog('isOpen')) {
		$("#wait_list").animate({opacity:1});
		$("#select_list_items").html("<option disabled='disabled'>Searching...</option>");
	}

	$.ajax({
		data: {
			jquery_ajax: 1,
			fname: 'search_lists',
			search_term: search_term,
			timestamp: new Date().getTime()
		},
		success : function(val) {
			var items = jQuery.parseJSON(val);
			if (!pageObj.timestamp_lists || items.timestamp > pageObj.timestamp_lists) {
				pageObj.timestamp_lists = items.timestamp;
				$('#list_preview').hide();
				$("#select_list_items").html(items.html);
				var width = $("#group_delete_box").dialog("option", "width");
				$("#select_list_items").width(width-40);
				$("#wait_list").animate({opacity:0});
				$('#import_list_box').dialog('open');
			}
		},
	});
}

function wait_to_search (search_func, search_term) {
	if (!search_term || search_term.length > 2) {
		pageObj.search_term = search_term;

		if (pageObj.time) {
			clearTimeout(pageObj.time);
		}

		pageObj.time = setTimeout(
			function() {
				search_func(pageObj.search_term);
			},
			500
		);
	}
}

function get_list_preview () {
	$('#list_preview').hide();
	$('#select_list_items > option:selected:last').each(
		function() {
			var item_spec = $(this).attr("value");
			$.ajax({
				data: {
					jquery_ajax: 1,
					fname: 'get_list_preview',
					item_spec: item_spec,
				},
				success :
					function(data) {
						var width = $("#import_list_box").dialog("option", "width");
						$("#select_list_items").width(width/2-30);
						$('#list_preview').width(width/2-30);
						$('#list_preview').html(data);
						$('#list_preview').fadeIn('fast');
					}
			});
		}
	);
}

function import_lists() {
	$('#select_list_items > option:selected').each(
		function() {
			var item_spec = $(this).attr("value");
			$.ajax({
				data: {
					jquery_ajax: 1,
					fname: 'get_genomes_for_list',
					item_spec: item_spec,
				},
				success :
					function(data) {
						add_to_list(data);
					}
			});
		}
	);
	$("#import_list_box").dialog('close');
}

</SCRIPT>

<!-- Collect-mode genome picker: search → organism → genome → basket.
     The hidden selects below remain the data model the page JS reads. -->
