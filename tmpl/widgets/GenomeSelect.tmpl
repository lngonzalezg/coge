		<div class="coge-picker-col">
			<div class="coge-picker-colhead">
				<span class="coge-picker-title">Genomes for Organism</span>
				<span id="genome_count" class="coge-picker-count"></span>
			</div>
			<div id="gpk_genome_rows" class="coge-picker-list"></div>
